# Copier vers misp-docker/.env et completer avant `docker compose up -d`
# Depot officiel : git clone https://github.com/MISP/misp-docker.git

CORE_TAG=v2.5.42
MODULES_TAG=v3.0.8
GUARD_TAG=v1.2

ADMIN_EMAIL=admin@soc-lab.local
ADMIN_ORG=SOC-LAB-PFA
ADMIN_PASSWORD=CHANGE_ME
GPG_PASSPHRASE=CHANGE_ME

# Le port 443 est deja pris par le dashboard Wazuh : on decale MISP
BASE_URL=https://127.0.0.1:8444
CORE_HTTP_PORT=8080
CORE_HTTPS_PORT=8444

MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Reduction memoire pour machine a RAM limitee (defauts: 2048M chacun)
PHP_MEMORY_LIMIT=512M
INNODB_BUFFER_POOL_SIZE=384M

DISABLE_IPV6=true
