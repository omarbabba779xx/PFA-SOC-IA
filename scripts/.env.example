# Copier vers .env et remplir avec les vraies valeurs (jamais commiter le .env
# rempli -- voir .gitignore). Toutes les variables ci-dessous sont lues par
# scripts/wazuh_ai_triage.py, scripts/triage_single_alert.py et
# scripts/evaluate_llm_vs_baseline.py.

# --- Wazuh Indexer (OpenSearch) ---
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=

# --- Ollama / LLM ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b-instruct-q4_0
# 0 = decharge le modele immediatement apres chaque appel (evite l'OOM
# documente dans le README sur une VM contrainte en RAM). N'augmenter que si
# la VM dispose de RAM suffisante pour garder le modele charge entre deux
# triages sans risquer de saturer la memoire avec le reste de la stack.
OLLAMA_KEEP_ALIVE=0
LLM_TEMPERATURE=0.1
LLM_NUM_PREDICT=300

# --- TheHive ---
# IPv4 explicite, pas "localhost" : requests resout localhost en IPv6 (::1)
# sur certaines VM, ce qui fait echouer l'authentification par cle API en 401
# silencieux (voir README, bug documente).
THEHIVE_URL=http://127.0.0.1:9000
THEHIVE_API_KEY=

# --- Seuils de triage ---
# Criticite minimale (basse/moyenne/haute/critique) a partir de laquelle un
# cas TheHive est cree.
CRITICALITY_THRESHOLD=moyenne
# rule.level minimum a partir duquel le LLM est invoque (complementaire du
# routage Shuffle qui gere le niveau 5-7, voir README).
LLM_INVOCATION_THRESHOLD_LEVEL=8

# --- Idempotence ---
WAZUH_AI_TRIAGE_STATE_DB=~/.wazuh_ai_triage_state.sqlite3

# --- Logging ---
LOG_LEVEL=INFO
