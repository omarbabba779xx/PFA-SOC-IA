<group name="local,pfa_custom,">

  <!-- Anchored on Wazuh's own native command-audit mechanism (rule 80792, key "audit-wazuh-c" from the
       official etc/lists/audit-keys CDB list) rather than a home-made field match on a raw audit key name.
       This is the officially documented Wazuh/auditd integration path.

       The audit source itself is pre-merged by a small local service (audit_merge.py, systemd unit
       audit-merge.service) that concatenates the SYSCALL/EXECVE/CWD/PATH/PROCTITLE records sharing the
       same audit(...) id into a single line, matching the format Wazuh's own auditd decoder documents
       and expects (see /var/ossec/ruleset/decoders/0040-auditd_decoders.xml) but which the raw
       /var/log/audit/audit.log never actually produces on its own (it writes one line per record type).
       Without this merge, the EXECVE arguments (URL, encoded command) never reach full_log, and any
       downstream consumer (rule engine, LLM, human analyst) is blind to the actual command content. -->
  <rule id="100099" level="8">
    <if_sid>80792</if_sid>
    <field name="audit.command">^curl$|^wget$</field>
    <description>Single network fetch via curl/wget - possible external tool/payload retrieval</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>audit_command,pfa_phishing,</group>
  </rule>

  <rule id="100101" level="12">
    <if_sid>80792</if_sid>
    <field name="audit.command">^pwsh$|^powershell$</field>
    <description>Suspicious PowerShell execution detected via auditd</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>audit_command,pfa_powershell,</group>
  </rule>

  <!-- C2 beaconing simulated: repeated curl/wget executions from the same source in a short window -->
  <rule id="100103" level="10" frequency="3" timeframe="90">
    <if_matched_sid>100099</if_matched_sid>
    <description>Repeated network fetch commands executed in a short window (possible C2 beaconing)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <group>audit_command,pfa_c2_beaconing,</group>
  </rule>

  <!-- Lateral movement simulated: successive SSH sessions followed by privilege escalation in a short window -->
  <rule id="100105" level="10" frequency="3" timeframe="120">
    <if_matched_sid>5715</if_matched_sid>
    <description>Multiple successive SSH sessions followed by privilege escalation (possible lateral movement)</description>
    <mitre>
      <id>T1021.004</id>
    </mitre>
    <group>pfa_lateral_movement,</group>
  </rule>

</group>
